# ============================================================================
# WatchMyStats — Variables d'environnement
# Copier ce fichier en ".env" et renseigner les valeurs réelles.
# Ne JAMAIS committer le fichier ".env" final.
# ============================================================================

# --- Base de données ---
DATABASE_URL="postgresql://user:password@localhost:5432/watchmystats"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # générer avec: openssl rand -base64 32

# --- Chiffrement des tokens OAuth stockés en base ---
TOKEN_ENCRYPTION_KEY="" # générer avec: openssl rand -hex 32

# --- Email (mot de passe oublié, rapports hebdomadaires) ---
RESEND_API_KEY=""
EMAIL_FROM="WatchMyStats <no-reply@watchmystats.app>"

# --- Rate limiting (optionnel, Upstash Redis) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- YouTube (Google OAuth + YouTube Data API v3 + YouTube Analytics API) ---
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/platforms/youtube/callback"

# --- TikTok (TikTok for Developers — Login Kit + Display API) ---
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/platforms/tiktok/callback"

# --- Instagram (Meta Graph API — Instagram Business Login) ---
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/platforms/instagram/callback"

# --- Twitch (Twitch API) ---
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_REDIRECT_URI="http://localhost:3000/api/platforms/twitch/callback"

# --- Facebook (Meta Graph API) ---
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/platforms/facebook/callback"

# --- X / Twitter (X API v2 OAuth 2.0) ---
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/platforms/x/callback"

# --- IA (préparé pour une future intégration LLM, ex: Anthropic) ---
AI_PROVIDER_API_KEY=""
