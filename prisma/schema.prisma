// ============================================================================
// WatchMyStats — Schéma de base de données
// ============================================================================
// Toutes les statistiques historiques sont conservées (jamais écrasées) afin
// de pouvoir reconstruire les graphiques d'évolution sur n'importe quelle
// période (24h / 7j / 30j / 90j / 1an / personnalisée).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// AUTHENTIFICATION (compatible NextAuth)
// ----------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  username       String?   @unique
  email          String    @unique
  emailVerified  DateTime?
  password       String? // hash bcrypt — null si l'utilisateur utilise uniquement OAuth
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Préférences
  theme                String  @default("dark") // dark | light | system
  notifySyncSuccess    Boolean @default(true)
  notifySyncError      Boolean @default(true)
  notifyWeeklyReport   Boolean @default(true)
  isDemoAccount        Boolean @default(false)

  accounts             Account[]
  sessions             Session[]
  platformAccounts     PlatformAccount[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
}

// Table technique requise par l'adapter NextAuth (connexions OAuth "login")
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// PLATEFORMES CONNECTÉES
// ----------------------------------------------------------------------------

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  TWITCH
  FACEBOOK
  X
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  ERROR
}

// Un compte de plateforme connecté par l'utilisateur.
// Les tokens OAuth sont chiffrés au repos (voir src/lib/crypto.ts) et ne
// sont JAMAIS renvoyés au frontend.
model PlatformAccount {
  id                  String     @id @default(cuid())
  userId              String
  platform            Platform
  externalAccountId   String // ID du compte côté plateforme (ex: channelId YouTube)
  displayName         String? // nom de chaîne / pseudo affiché
  handle              String? // @handle si applicable
  avatarUrl           String?

  accessTokenEnc      String?    @db.Text // token chiffré (AES-256-GCM)
  refreshTokenEnc     String?    @db.Text // token chiffré
  tokenExpiresAt       DateTime?
  scope               String?

  isDemo              Boolean    @default(false)
  isActive            Boolean    @default(true)

  lastSyncAt          DateTime?
  lastSyncStatus      SyncStatus @default(IDLE)
  lastSyncError       String?

  followerCount       Int?       // dernière valeur connue (dénormalisée pour affichage rapide)

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos               Video[]
  followerStatistics   FollowerStatistic[]
  revenues             Revenue[]
  syncLogs             SyncLog[]

  @@unique([userId, platform, externalAccountId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// CONTENUS
// ----------------------------------------------------------------------------

enum ContentType {
  VIDEO
  SHORT
  REEL
  LIVE
  POST
}

model Video {
  id                String      @id @default(cuid())
  platformAccountId String
  externalId        String // ID de la vidéo côté plateforme
  title             String
  thumbnailUrl      String?
  url               String?
  contentType       ContentType @default(VIDEO)
  publishedAt       DateTime?

  isDemo            Boolean     @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  platformAccount   PlatformAccount    @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  statistics        VideoStatistic[]

  @@unique([platformAccountId, externalId])
  @@index([platformAccountId])
}

// Point de statistique horodaté pour une vidéo — un nouvel enregistrement
// est créé à chaque synchronisation afin de préserver l'historique complet
// (nécessaire pour tracer les courbes d'évolution).
model VideoStatistic {
  id               String   @id @default(cuid())
  videoId          String
  recordedAt       DateTime @default(now())

  views            Int      @default(0)
  likes            Int      @default(0)
  comments         Int      @default(0)
  shares           Int?     // null si non fourni par l'API
  avgViewDuration  Int?     // secondes — null si non disponible
  retentionRate    Float?   // 0–100 — null si non disponible

  // Score de performance calculé (voir src/services/analytics/performance-score.ts)
  performanceScore Int?

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, recordedAt])
}

// Historique des abonnés/followers au niveau du compte (toutes plateformes confondues)
model FollowerStatistic {
  id                String   @id @default(cuid())
  platformAccountId String
  recordedAt        DateTime @default(now())
  followerCount     Int
  viewCount         Int? // vues cumulées de la chaîne quand disponible

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@index([platformAccountId, recordedAt])
}

// ----------------------------------------------------------------------------
// REVENUS
// ----------------------------------------------------------------------------

model Revenue {
  id                String   @id @default(cuid())
  platformAccountId String
  periodStart       DateTime
  periodEnd         DateTime
  amountCents        Int // montant en centimes pour éviter les erreurs d'arrondi
  currency          String   @default("EUR")
  isEstimate        Boolean  @default(true)
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@index([platformAccountId, periodStart])
}

// ----------------------------------------------------------------------------
// SYNCHRONISATION
// ----------------------------------------------------------------------------

enum SyncTrigger {
  MANUAL
  SCHEDULED
  INITIAL_CONNECT
}

model SyncLog {
  id                String      @id @default(cuid())
  platformAccountId String
  trigger           SyncTrigger
  status            SyncStatus
  startedAt         DateTime    @default(now())
  finishedAt        DateTime?
  videosSynced      Int         @default(0)
  errorMessage      String?

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@index([platformAccountId, startedAt])
}

// ----------------------------------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------------------------------

enum NotificationType {
  SYNC_SUCCESS
  SYNC_ERROR
  WEEKLY_REPORT
  SYSTEM
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
